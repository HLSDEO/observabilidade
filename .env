# Diretório de cron do host montado no backend (em /host-cron.d).
# Na VM Ubuntu, aponte para o cron real do sistema:
#   CRON_DIR=/etc/cron.d
# Localmente (dev), deixe vazio para usar ./data/cron.d e não tocar no cron da máquina.
CRON_DIR=/etc/cron.d

# Diretório do host onde o Ubuntu guarda os crontabs criados via `crontab -e`.
# Ex.: /var/spool/cron/crontabs
HOST_CRONTAB_DIR=/var/spool/cron/crontabs

# Usuários cujos crontabs devem aparecer na rota /cron.
# Ex.: root,ubuntu
HOST_CRONTAB_USERS=root
