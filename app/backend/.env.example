# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/observabilidade_logs
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# Application
APP_NAME="Observabilidade Logs"
DEBUG=true

# Cron Configuration
CRON_FILE=/host-cron.d/observabilidade
CRONTAB_SPOOL_DIR=/host-crontabs
CRONTAB_USERS=

# Timezone
TZ=America/Sao_Paulo
